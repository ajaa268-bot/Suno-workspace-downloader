{
  "manifest_version": 3,
  "name": "Standalone Suno Workspace Exporter v7.1 Ultimate Edition",
  "version": "7.1",
  "description": "Universal Exporter & Bridge for Suno AI workspaces and Portable Organizer Suite.",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*.suno.com/*",
    "https://*.suno.ai/*",
    "https://studio-api.prod.suno.com/*",
    "https://clerk.suno.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Suno Workspace Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.suno.com/*"
      ],
      "js": ["content_suno.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "file:///*workspace-organizer-portable.html*",
        "http://localhost/*workspace-organizer-portable.html*",
        "http://127.0.0.1/*workspace-organizer-portable.html*"
      ],
      "js": ["bridge_organizer.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "content_suno.js"],
      "matches": ["https://*.suno.com/*"]
    }
  ]
}
